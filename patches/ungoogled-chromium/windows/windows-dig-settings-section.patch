+  </div>
+  <div class="cr-row continuation">
+    <cr-input class="flex" id="nodeUrl"
+        value="{{nodeUrl_}}"
+        on-change="onNodeUrlChanged_"
+        invalid="[[nodeUrlInvalid_]]"
+        error-message="$i18n{digNodeEndpointInvalid}"
+        placeholder="$i18n{digNodeEndpointPlaceholder}"
+        spellcheck="false" autocomplete="off">
+    </cr-input>
+  </div>
+  <div class="cr-row">
+    <cr-button on-click="onResetClick_">
+      $i18n{digNodeEndpointReset}
+    </cr-button>
+  </div>
+</settings-section>
